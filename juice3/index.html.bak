<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Custom Juice | Fresh, Made-To-Order Juices Delivered to Your Door</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        },
                        citrus: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        },
                        berry: {
                            500: '#ec4899',
                            600: '#db2777',
                        }
                    },
                    fontFamily: {
                        heading: ['Outfit', 'sans-serif'],
                        body: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        .bg-glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-brand-500 selection:text-white">

    <!-- Top Announcement Bar -->
    <div id="top-bar" class="bg-brand-900 text-brand-100 text-xs sm:text-sm py-2 px-4 text-center font-medium flex justify-between items-center px-6">
        <div class="hidden md:block"></div>
        <div class="flex items-center justify-center gap-2 mx-auto md:mx-0">
            <span class="inline-block w-2 h-2 rounded-full bg-brand-400 animate-ping"></span>
            <span>Made fresh on order! Delivered straight to your doorstep.</span>
        </div>
        <div class="flex items-center gap-4 text-xs">
            <button onclick="toggleAdminDrawer()" class="hover:text-brand-300 transition-colors flex items-center gap-1 opacity-80 hover:opacity-100">
                <i class="fa-solid fa-gear">="text-xs"></i> Owner Config
            </button>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 bg-glass border-b border-slate-200/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-600 via-brand-500 to-citrus-400 flex items-center justify-center text-white text-2xl shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-citrus"></i>
                </div>
                <div>
                    <span class="text-2xl font-extrabold tracking-tight text-slate-900 font-heading block leading-none site-name-text">Custom Juice</span>
                    <span class="text-xs font-semibold text-brand-600 tracking-wider uppercase mt-1 block">Fresh • Pure • Delivered</span>
                </div>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-8 font-medium text-slate-600 text-sm">
                <a href="#hero" class="hover:text-brand-600 transition-colors">Home</a>
                <a href="#menu" class="hover:text-brand-600 transition-colors">Our Menu</a>
                <a href="#custom-builder" class="hover:text-brand-600 transition-colors">Build Your Own</a>
                <a href="#ordering" class="hover:text-brand-600 transition-colors">How to Order</a>
                <a href="#catering" class="hover:text-brand-600 transition-colors">Catering & Cleanses</a>
            </nav>

            <!-- Action Buttons -->
            <div class="flex items-center gap-3">
                <a href="tel:5550192837" class="site-phone-link hidden sm:inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold px-4 py-2.5 rounded-full text-sm transition-all border border-slate-200">
                    <i class="fa-solid fa-phone text-brand-600"></i>
                    <span class="site-phone-display">(555) 019-2837</span>
                </a>

                <!-- Cart / Order Drawer Button -->
                <button onclick="toggleCartDrawer()" class="relative bg-brand-600 hover:bg-brand-700 text-white font-semibold px-4 py-2.5 rounded-full text-sm transition-all flex items-center gap-2 shadow-md shadow-brand-500/20 hover:scale-105">
                    <i class="fa-solid fa-basket-shopping"></i>
                    <span class="hidden sm:inline">Phone Order</span>
                    <span id="cart-count" class="bg-white text-brand-700 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold">0</span>
                </button>

                <!-- Mobile Menu Button -->
                <button onclick="toggleMobileMenu()" class="md:hidden text-slate-700 p-2 rounded-lg hover:bg-slate-100">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-6 space-y-3">
            <a href="#hero" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium border-b border-slate-100">Home</a>
            <a href="#menu" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium border-b border-slate-100">Our Menu</a>
            <a href="#custom-builder" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium border-b border-slate-100">Build Your Own</a>
            <a href="#ordering" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium border-b border-slate-100">How to Order</a>
            <a href="#catering" onclick="toggleMobileMenu()" class="block py-2 text-slate-700 font-medium">Catering & Cleanses</a>
            <div class="pt-2">
                <a href="tel:5550192837" class="site-phone-link flex items-center justify-center gap-2 w-full bg-brand-50 text-brand-700 font-semibold py-3 rounded-xl border border-brand-200">
                    <i class="fa-solid fa-phone"></i>
                    <span>Call to Order: <span class="site-phone-display">(555) 019-2837</span></span>
                </a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section id="hero" class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-brand-50/60 via-slate-50 to-slate-50">
        <!-- Background decorative blobs -->
        <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-citrus-400/10 blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-96 h-96 rounded-full bg-brand-500/10 blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                
                <!-- Left Text Content -->
                <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
                    
                    <div class="inline-flex items-center gap-2 bg-brand-100/80 text-brand-800 text-xs sm:text-sm font-semibold px-4 py-2 rounded-full border border-brand-200 shadow-sm">
                        <i class="fa-solid fa-leaf text-brand-600"></i>
                        <span>100% Organic, Pure & Homemade Cold Pressed</span>
                    </div>

                    <!-- Headline (Exact Prompt Copy) -->
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        Fresh. Custom. <br class="hidden sm:inline">
                        <span class="bg-gradient-to-r from-brand-600 via-brand-500 to-citrus-500 bg-clip-text text-transparent">Made for You.</span>
                    </h1>

                    <!-- Introduction (Exact Prompt Copy) -->
                    <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                        At <span class="site-name-text font-bold text-slate-800">Custom Juice</span>, we believe great juice starts with fresh ingredients and your own taste. We create delicious fruit and vegetable juices made to order, using creative combinations designed to give you something fresh and flavorful in every bottle.
                    </p>

                    <!-- Call to Action (Exact Prompt Copy) -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 space-y-4">
                        <div class="space-y-1">
                            <h3 class="text-xl font-bold text-slate-900 font-heading">Choose your juice. Make it your own.</h3>
                            <p class="text-sm text-slate-600">Browse our menu or call us to create your own custom combination.</p>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                            <a href="#menu" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-brand-500/25 transition-all hover:scale-[1.02] text-base">
                                <i class="fa-solid fa-wine-bottle"></i>
                                Browse Menu
                            </a>
                            <a href="tel:5550192837" class="site-phone-link w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all hover:scale-[1.02] text-base">
                                <i class="fa-solid fa-phone text-brand-400"></i>
                                Call to Order: <span class="site-phone-display">(555) 019-2837</span>
                            </a>
                        </div>
                    </div>

                    <!-- Trust highlights -->
                    <div class="pt-2 grid grid-cols-3 gap-4 border-t border-slate-200/80 text-center">
                        <div>
                            <div class="text-2xl font-bold text-slate-900 font-heading">100%</div>
                            <div class="text-xs text-slate-500 font-medium">Fresh Ingredients</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-slate-900 font-heading">Made Fresh</div>
                            <div class="text-xs text-slate-500 font-medium">After You Order</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-slate-900 font-heading">Direct</div>
                            <div class="text-xs text-slate-500 font-medium">Doorstep Delivery</div>
                        </div>
                    </div>

                </div>

                <!-- Right Visual Display -->
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md lg:max-w-none">
                        
                        <!-- Main Feature Card -->
                        <div class="relative bg-white p-4 rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform lg:rotate-1 hover:rotate-0 transition-transform duration-500">
                            <img src="https://images.unsplash.com/photo-1622597467836-f3285f2131b7?auto=format&fit=crop&w=800&q=80" alt="Fresh Custom Juice" class="w-full h-80 sm:h-96 object-cover rounded-2xl">
                            
                            <!-- Floating Badge 1 -->
                            <div class="absolute top-8 left-8 bg-glass p-3 rounded-2xl shadow-lg border border-white/60 flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-citrus-500 text-white flex items-center justify-center text-lg font-bold">
                                    <i class="fa-solid fa-bolt"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-slate-800">Energy & Immunity</div>
                                    <div class="text-[10px] text-slate-500">No added sugars or preservatives</div>
                                </div>
                            </div>

                            <!-- Floating Badge 2 -->
                            <div class="absolute bottom-8 right-8 bg-glass p-3 rounded-2xl shadow-lg border border-white/60 flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-truck-fast"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-slate-800">Home Delivery</div>
                                    <div class="text-[10px] text-slate-500">Delivered ice-cold</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ORDERING SECTION BANNER (Exact Prompt Copy) -->
    <section id="ordering" class="py-12 bg-gradient-to-r from-brand-800 via-brand-700 to-brand-900 text-white relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8 bg-white/10 backdrop-blur-md p-8 sm:p-10 rounded-3xl border border-white/20">
                
                <div class="space-y-3 text-center md:text-left max-w-2xl">
                    <span class="inline-block px-3 py-1 bg-citrus-500 text-slate-900 font-extrabold text-xs tracking-wider uppercase rounded-full">Fast Phone Ordering</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight font-heading">Ready for a fresh juice?</h2>
                    <p class="text-lg text-brand-100 leading-relaxed">
                        Give us a call and place your order. We'll prepare your juice fresh and ready for you.
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
                    <a href="tel:5550192837" class="site-phone-link w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-citrus-400 hover:bg-citrus-500 text-slate-900 font-extrabold px-8 py-4 rounded-2xl shadow-xl transition-all hover:scale-105 text-lg">
                        <i class="fa-solid fa-phone"></i>
                        <span>Call <span class="site-phone-display">(555) 019-2837</span></span>
                    </a>
                    <button onclick="toggleCartDrawer()" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/20 hover:bg-white/30 text-white font-semibold px-6 py-4 rounded-2xl border border-white/30 transition-all text-base">
                        <i class="fa-solid fa-list-check"></i>
                        <span>Review Order List</span>
                    </button>
                </div>

            </div>
        </div>
    </section>

    <!-- JUICE MENU SECTION -->
    <section id="menu" class="py-20 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
            
            <!-- Section Header -->
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="text-brand-600 font-bold text-sm tracking-wider uppercase">Made Fresh On Order</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-heading">Our Handcrafted Menu</h2>
                <p class="text-slate-600 text-base sm:text-lg">Select your favorites below to build your phone order list or call us to customize any recipe.</p>
            </div>

            <!-- Filters & Search Bar -->
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 border-b border-slate-200 pb-6">
                <!-- Category Tabs -->
                <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 custom-scrollbar">
                    <button onclick="filterMenu('all')" class="menu-tab active bg-brand-600 text-white px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition-all shadow-sm">All Juices</button>
                    <button onclick="filterMenu('green')" class="menu-tab bg-white text-slate-600 hover:bg-slate-100 px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition-all border border-slate-200">Green Juices</button>
                    <button onclick="filterMenu('citrus')" class="menu-tab bg-white text-slate-600 hover:bg-slate-100 px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition-all border border-slate-200">Citrus & Roots</button>
                    <button onclick="filterMenu('shots')" class="menu-tab bg-white text-slate-600 hover:bg-slate-100 px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition-all border border-slate-200">Wellness Shots</button>
                </div>

                <!-- Search input -->
                <div class="relative w-full md:w-72">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="menu-search" oninput="searchMenu()" placeholder="Search ingredients or juices..." class="w-full pl-10 pr-4 py-2.5 bg-white rounded-full border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 shadow-sm">
                </div>
            </div>

            <!-- Menu Grid -->
            <div id="menu-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Menu Cards will be dynamically rendered via JS -->
            </div>

        </div>
    </section>

    <!-- INTERACTIVE "BUILD YOUR OWN" JUICE SECTION -->
    <section id="custom-builder" class="py-20 bg-slate-900 text-white relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12">
            
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="text-citrus-400 font-bold text-sm tracking-wider uppercase">Your Taste • Your Blend</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold font-heading">Build Your Own Custom Juice</h2>
                <p class="text-slate-300 text-base sm:text-lg">Pick your base, favorite greens, fruit flavors, and superfood boosts. We'll juice it fresh for you!</p>
            </div>

            <div class="bg-slate-800/80 rounded-3xl p-6 sm:p-10 border border-slate-700 shadow-2xl max-w-4xl mx-auto space-y-8">
                
                <!-- Step 1: Bottle Size -->
                <div class="space-y-3">
                    <label class="block text-sm font-bold uppercase tracking-wider text-citrus-400">1. Select Bottle Size</label>
                    <div class="grid grid-cols-3 gap-4">
                        <button onclick="selectCustomSize('12 oz', 7.50)" class="custom-size-btn active p-4 rounded-2xl border-2 border-brand-500 bg-brand-500/10 text-center font-bold">
                            <div class="text-lg">12 oz</div>
                            <div class="text-xs text-slate-300">$7.50</div>
                        </button>
                        <button onclick="selectCustomSize('16 oz', 9.50)" class="custom-size-btn p-4 rounded-2xl border-2 border-slate-700 bg-slate-800 text-center font-bold">
                            <div class="text-lg">16 oz</div>
                            <div class="text-xs text-slate-300">$9.50</div>
                        </button>
                        <button onclick="selectCustomSize('32 oz', 16.00)" class="custom-size-btn p-4 rounded-2xl border-2 border-slate-700 bg-slate-800 text-center font-bold">
                            <div class="text-lg">32 oz</div>
                            <div class="text-xs text-slate-300">$16.00</div>
                        </button>
                    </div>
                </div>

                <!-- Step 2: Liquid Base -->
                <div class="space-y-3">
                    <label class="block text-sm font-bold uppercase tracking-wider text-citrus-400">2. Choose 1 Liquid Base</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="radio" name="custom-base" value="Green Apple Base" checked class="text-brand-500">
                            <span class="text-sm font-medium">Green Apple</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="radio" name="custom-base" value="Coconut Water Base" class="text-brand-500">
                            <span class="text-sm font-medium">Coconut Water</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="radio" name="custom-base" value="Fresh Orange Juice Base" class="text-brand-500">
                            <span class="text-sm font-medium">Fresh Orange</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="radio" name="custom-base" value="Cucumber Base" class="text-brand-500">
                            <span class="text-sm font-medium">Cucumber</span>
                        </label>
                    </div>
                </div>

                <!-- Step 3: Mix-ins -->
                <div class="space-y-3">
                    <label class="block text-sm font-bold uppercase tracking-wider text-citrus-400">3. Select Up to 3 Ingredients</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Spinach" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Organic Spinach</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Kale" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Fresh Kale</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Pineapple" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Sweet Pineapple</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Celery" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Crisp Celery</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Beetroot" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Red Beetroot</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Carrot" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Sweet Carrot</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Lemon Juice" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Zesty Lemon</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-ingredient" value="Mint" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Fresh Mint</span>
                        </label>
                    </div>
                </div>

                <!-- Step 4: Superfood Boosters -->
                <div class="space-y-3">
                    <label class="block text-sm font-bold uppercase tracking-wider text-citrus-400">4. Superfood Boosters (+$1.00 each)</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-booster" value="Raw Ginger" onchange="calculateCustomTotal()" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Raw Ginger</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-booster" value="Turmeric" onchange="calculateCustomTotal()" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Fresh Turmeric</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-booster" value="Chia Seeds" onchange="calculateCustomTotal()" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Chia Seeds</span>
                        </label>
                        <label class="cursor-pointer bg-slate-700/50 hover:bg-slate-700 p-3 rounded-xl border border-slate-600 flex items-center gap-2">
                            <input type="checkbox" name="custom-booster" value="Cayenne" onchange="calculateCustomTotal()" class="text-brand-500 rounded">
                            <span class="text-sm font-medium">Cayenne Pepper</span>
                        </label>
                    </div>
                </div>

                <!-- Custom Juice Summary Footer -->
                <div class="pt-6 border-t border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div>
                        <div class="text-xs text-slate-400 uppercase font-bold tracking-wider">Custom Blend Total</div>
                        <div class="text-3xl font-extrabold text-white" id="custom-total-display">$7.50</div>
                    </div>
                    <button onclick="addCustomJuiceToCart()" class="w-full sm:w-auto bg-brand-500 hover:bg-brand-600 text-slate-950 font-extrabold px-8 py-4 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 text-base">
                        <i class="fa-solid fa-plus"></i>
                        Add Custom Blend to Order
                    </button>
                </div>

            </div>

        </div>
    </section>

    <!-- LOCAL DELIVERY ZIP CHECKER -->
    <section class="py-16 bg-brand-50/50 border-y border-brand-100">
        <div class="max-w-4xl mx-auto px-4 text-center space-y-6">
            <div class="inline-flex items-center gap-2 text-brand-700 bg-brand-100/80 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">
                <i class="fa-solid fa-map-location-dot"></i> Home Delivery Zone
            </div>
            <h2 class="text-3xl font-bold text-slate-900 font-heading">Check If We Deliver To Your Neighborhood</h2>
            <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto">We deliver homemade juices directly to your home in temperature-controlled cooler bags.</p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
                <input type="text" id="zip-input" maxlength="5" placeholder="Enter your 5-digit ZIP code" class="w-full px-5 py-3.5 bg-white border border-slate-300 rounded-xl text-center text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-brand-500">
                <button onclick="checkZipCode()" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-3.5 rounded-xl transition-all whitespace-nowrap">
                    Check Delivery
                </button>
            </div>
            <div id="zip-result" class="text-sm font-semibold hidden"></div>
        </div>
    </section>

    <!-- CATERING & DETOX CLEANSE FORM -->
    <section id="catering" class="py-20 bg-slate-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
            <div class="text-center space-y-3">
                <span class="text-brand-600 font-bold text-sm tracking-wider uppercase">Large Orders & Events</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-heading">Catering & Multi-Day Cleanses</h2>
                <p class="text-slate-600">Planning an office event, wellness party, or starting a 3-day detox program? Send us a quick inquiry!</p>
            </div>

            <form onsubmit="handleCateringSubmit(event)" class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-xl space-y-6">
                <div class="grid sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Your Name *</label>
                        <input type="text" required placeholder="John Doe" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Phone Number *</label>
                        <input type="tel" required placeholder="(555) 000-0000" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Service Type</label>
                        <select class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="Multi-Day Cleanse (3-5 Days)">Multi-Day Juice Cleanse</option>
                            <option value="Office / Party Catering">Office / Event Catering</option>
                            <option value="Recurring Weekly Subscription">Recurring Weekly Home Delivery</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Estimated Quantity (Bottles)</label>
                        <input type="number" min="6" placeholder="e.g. 12 bottles" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Notes or Dietary Preferences</label>
                    <textarea rows="3" placeholder="Tell us about specific fruit preferences, allergies, or delivery dates..." class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
                </div>

                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-4 rounded-xl shadow-lg transition-all text-base">
                    Send Catering / Cleanse Request
                </button>
            </form>
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-16 bg-white border-t border-slate-200">
        <div class="max-w-3xl mx-auto px-4 space-y-8">
            <div class="text-center space-y-2">
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-heading">Frequently Asked Questions</h2>
                <p class="text-slate-500 text-sm">Everything you need to know about our fresh juices and doorstep delivery.</p>
            </div>

            <div class="space-y-4">
                <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
                    <h3 class="font-bold text-slate-900 mb-1">How long do the juices last?</h3>
                    <p class="text-sm text-slate-600">Because our juices are 100% natural without added preservatives, they stay freshest for 3 to 5 days when kept refrigerated.</p>
                </div>
                <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
                    <h3 class="font-bold text-slate-900 mb-1">How do I place my phone order?</h3>
                    <p class="text-sm text-slate-600">Browse the menu, click "Add to Order" for your chosen items, then tap the Phone Order button to see your summary and call or text us directly!</p>
                </div>
                <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
                    <h3 class="font-bold text-slate-900 mb-1">Is there a minimum order for doorstep delivery?</h3>
                    <p class="text-sm text-slate-600">Our standard delivery minimum is $20.00. Free delivery is applied for orders over $35.00 within our delivery zone.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-800">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-brand-500 text-slate-950 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-citrus"></i>
                    </div>
                    <span class="text-2xl font-bold text-white font-heading site-name-text">Custom Juice</span>
                </div>
                <div class="flex items-center gap-6 text-sm font-medium">
                    <a href="#hero" class="hover:text-white transition-colors">Home</a>
                    <a href="#menu" class="hover:text-white transition-colors">Menu</a>
                    <a href="#custom-builder" class="hover:text-white transition-colors">Custom Builder</a>
                    <a href="#ordering" class="hover:text-white transition-colors">How to Order</a>
                </div>
